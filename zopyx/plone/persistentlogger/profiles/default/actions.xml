<?xml version="1.0" encoding="utf-8"?>
<object xmlns:i18n="http://xml.zope.org/namespaces/i18n"
        meta_type="Plone Actions Tool"
        name="portal_actions">
  <object meta_type="CMF Action Category" name="object_buttons">
    <object meta_type="CMF Action"
            name="persistentlogger"
            i18n:domain="zopyx.plone.persistentlogger">
      <property name="title">Logging</property>
      <property name="description">View the audit log for this item.</property>
      <property name="url_expr">string:${object_url}/@@persistent-log</property>
      <property name="icon_expr">string:clipboard-check</property>
      <property name="available_expr">object/@@persistentlogger-enabled</property>
      <property name="permissions">
        <element value="View audit log" />
      </property>
      <property name="visible">True</property>
    </object>
  </object>
  <object meta_type="CMF Action Category" name="object">
    <object meta_type="CMF Action"
            name="persistentlogger-log"
            i18n:domain="zopyx.plone.persistentlogger">
      <property name="title">Logging</property>
      <property name="description">View the audit log for this item.</property>
      <property name="url_expr">string:${object_url}/@@persistent-log</property>
      <property name="icon_expr">string:clipboard-check</property>
      <property name="available_expr">object/@@persistentlogger-enabled|nothing</property>
      <property name="permissions">
        <element value="View audit log" />
      </property>
      <property name="visible">True</property>
    </object>
  </object>
</object>
