<html xmlns="http://www.w3.org/1999/xhtml"
      xmlns:tal="http://xml.zope.org/namespaces/tal"
      xmlns:metal="http://xml.zope.org/namespaces/metal"
      metal:use-macro="context/main_template/macros/master">
  <metal:block fill-slot="head_slot">
    <link rel="stylesheet" href="https://unpkg.com/survey-core@3.0.4/survey-core.min.css" />
    <link rel="stylesheet" href="++resource++persistentlogger/controlpanel.css?v=1" />
  </metal:block>
  <metal:block fill-slot="javascript_head_slot">
    <script src="https://unpkg.com/survey-core@3.0.4/survey.core.min.js"></script>
    <script src="https://unpkg.com/survey-js-ui@3.0.4/survey-js-ui.min.js"></script>
    <script src="++resource++persistentlogger/controlpanel.js?v=3"></script>
  </metal:block>
  <body>
    <metal:block fill-slot="main">
      <main id="persistentlogger-controlpanel"
            tal:attributes="data-save-url view/save_url; data-redirect-url view/redirect_url; data-survey python:__import__('json').dumps(view.survey())">
        <div id="persistentlogger-survey"></div>
      </main>
    </metal:block>
  </body>
</html>
